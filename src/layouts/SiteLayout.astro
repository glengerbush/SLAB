---
import "../styles/global.css";
import SocialIcon from "../components/SocialIcon.astro";
import type { SiteSettings } from "../lib/schema";
import {
  absoluteUrl,
  accentContrast,
  openGraphLocale,
  readableAccent,
  socialImagePath,
} from "../lib/presentation";

interface Props {
  settings: SiteSettings;
  title?: string;
  description?: string;
  path: string;
  socialImage?: string | null;
  type?: "website" | "article";
}

const {
  settings,
  title,
  description = settings.description,
  path,
  socialImage,
  type = "website",
} = Astro.props;
const pageTitle = title ? `${title} — ${settings.title}` : settings.title;
const canonical = absoluteUrl(settings, path);
const effectiveSocialImage = socialImagePath(settings, socialImage);
const socialImageUrl = effectiveSocialImage
  ? absoluteUrl(settings, effectiveSocialImage)
  : null;
const socialLocale = openGraphLocale(settings.locale);
const accentLight = readableAccent(settings.accentColor, "light");
const accentDark = readableAccent(settings.accentColor, "dark");
const normalizedPath = path === "/" ? path : path.replace(/\/+$/, "");
const navigationIsActive = (href: string) => {
  if (!href.startsWith("/") || href.startsWith("//")) return false;
  const target = href === "/" ? href : href.replace(/\/+$/, "");
  return target === "/"
    ? normalizedPath === "/" || normalizedPath.startsWith("/posts/")
    : normalizedPath === target || normalizedPath.startsWith(`${target}/`);
};
---

<!doctype html>
<html
  lang={settings.locale}
  style={`--accent-base:${settings.accentColor};--accent-light:${accentLight};--accent-dark:${accentDark};--accent-contrast:${accentContrast(settings.accentColor)}`}
>
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <script is:inline src="/theme.js"></script>
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {
      (!settings.robots.index || !settings.robots.follow) && (
        <meta
          name="robots"
          content={`${settings.robots.index ? "index" : "noindex"}, ${settings.robots.follow ? "follow" : "nofollow"}`}
        />
      )
    }
    <link rel="canonical" href={canonical} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={settings.title}
      href="/rss.xml"
    />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={socialLocale} />
    <meta property="og:site_name" content={settings.title} />
    {socialImageUrl && <meta property="og:image" content={socialImageUrl} />}
    <meta
      name="twitter:card"
      content={socialImageUrl ? "summary_large_image" : "summary"}
    />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {socialImageUrl && <meta name="twitter:image" content={socialImageUrl} />}
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <header class="site-header shell">
      <a class="site-title" href="/">{settings.title}</a>
      <nav class="site-nav" aria-label="Primary">
        <ul>
          {
            settings.navigation.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={
                    navigationIsActive(item.href) ? "page" : undefined
                  }
                >
                  {item.label}
                  {item.href === "/rss.xml" && (
                    <svg
                      class="nav-rss-icon"
                      aria-hidden="true"
                      focusable="false"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.25"
                      stroke-linecap="round"
                    >
                      <circle
                        cx="5"
                        cy="19"
                        r="1.5"
                        fill="currentColor"
                        stroke="none"
                      />
                      <path d="M4 11a9 9 0 0 1 9 9" />
                      <path d="M4 4a16 16 0 0 1 16 16" />
                    </svg>
                  )}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <fieldset class="theme-selector">
        <legend class="visually-hidden">Theme</legend>
        <label>
          <input type="radio" name="theme" value="light" />
          Light
        </label>
        <label>
          <input type="radio" name="theme" value="dark" />
          Dark
        </label>
        <label>
          <input type="radio" name="theme" value="system" checked />
          System
        </label>
      </fieldset>
    </header>
    <main id="content" class="shell"><slot /></main>
    <footer class="site-footer shell">
      <span>© {new Date().getUTCFullYear()} {settings.author}</span>
      {
        settings.socialLinks.length > 0 && (
          <ul class="social-links">
            {settings.socialLinks.map((item) => (
              <li>
                <a rel="me" href={item.href} title={item.label}>
                  <SocialIcon {...item} />
                  <span class="visually-hidden">{item.label}</span>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </footer>
  </body>
</html>
